
{
  "name": "JungleScript",
  "scopeName": "source.junglescript",
  "fileTypes": [
    "jls"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#modules"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.junglescript",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.junglescript",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.junglescript"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.junglescript"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.junglescript",
              "match": "\\\\(?:[\"\\\\nrt]|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.junglescript",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.junglescript"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.junglescript"
            }
          }
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.junglescript",
          "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.junglescript",
          "match": "\\b(?:use|page|heading|text|button|download|createFile|uploadcomputerdata)\\b"
        }
      ]
    },

    "modules": {
      "patterns": [
        {
          "name": "entity.name.type.module.junglescript",
          "match": "\\b(?:JungleWeb|JungleGame|JungleOS)\\b"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.junglescript",
          "match": "\\b(?:file_name|use|page|heading|text|button|download|createFile|uploadcomputerdata)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.junglescript",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },

    "booleans": {
      "patterns": [
        {
          "name": "constant.language.junglescript",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.junglescript",
          "match": "===|!==|==|!=|<=|>=|=>|&&|\\|\\||[=+\\-*/%<>!]"
        }
      ]
    }
  }
}